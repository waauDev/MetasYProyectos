@model MetasYProyectos.Web.ViewModels.PeriodoAdministrativoListaViewModel
@{
    ViewData["Title"] = "Periodos administrativos";
}

<div class="page-heading">
    <div class="page-pretitle">Datos básicos</div>
    <h3 class="page-title">Periodos administrativos</h3>
</div>

<div class="row row-cards">
    <div class="col-12 col-xl-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">@(Model.Form.EsNuevo ? "Nuevo periodo" : $"Editar periodo {Model.Form.IdPeriodo}")</h3>
            </div>
            <div class="card-body">
                <form asp-action="Guardar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Form.EsNuevo" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Form.IdPeriodo"></label>
                        @if (Model.Form.EsNuevo)
                        {
                            <input class="form-control" asp-for="Form.IdPeriodo" />
                        }
                        else
                        {
                            <input type="hidden" asp-for="Form.IdPeriodo" />
                            <input class="form-control" value="@Model.Form.IdPeriodo" disabled />
                        }
                        <span asp-validation-for="Form.IdPeriodo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Form.NitGobernante"></label>
                        <input class="form-control" asp-for="Form.NitGobernante" id="nitGobernante" list="nitOptions" autocomplete="off" placeholder="Escriba NIT o nombre" />
                        <datalist id="nitOptions"></datalist>
                        <span asp-validation-for="Form.NitGobernante" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Form.NombreGobernante"></label>
                        <input class="form-control" id="nombreGobernante" value="@Model.Form.NombreGobernante" disabled />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" asp-for="Form.FechaInicio"></label>
                            <input class="form-control" asp-for="Form.FechaInicio" type="date" />
                            <span asp-validation-for="Form.FechaInicio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" asp-for="Form.FechaFinal"></label>
                            <input class="form-control" asp-for="Form.FechaFinal" type="date" />
                            <span asp-validation-for="Form.FechaFinal" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Form.Cantidad"></label>
                        <input class="form-control" asp-for="Form.Cantidad" />
                        <span asp-validation-for="Form.Cantidad" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-primary">
                            <i class="ti ti-eraser me-1"></i> Limpiar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i> Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-8">
        <div class="card mb-3">
            <div class="card-body">
                <form asp-action="Index" method="get" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label" asp-for="Filtro.IdPeriodoInicial"></label>
                        <input class="form-control" asp-for="Filtro.IdPeriodoInicial" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" asp-for="Filtro.IdPeriodoFinal"></label>
                        <input class="form-control" asp-for="Filtro.IdPeriodoFinal" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Filtro.NitGobernante"></label>
                        <input class="form-control" asp-for="Filtro.NitGobernante" />
                    </div>
                    <div class="col-md-auto">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-search me-1"></i> Buscar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title mb-0">Periodos registrados</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>NIT gobernante</th>
                            <th>Gobernante</th>
                            <th>Fecha inicial</th>
                            <th>Fecha final</th>
                            <th>Cantidad</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="ti ti-calendar-time d-block mb-2 fs-1"></i>
                                    No hay periodos administrativos registrados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td><strong>@item.IdPeriodo</strong></td>
                                    <td>@item.NitGobernante</td>
                                    <td>@item.NombreGobernante</td>
                                    <td>@item.FechaInicio?.ToString("dd/MM/yyyy")</td>
                                    <td>@item.FechaFinal?.ToString("dd/MM/yyyy")</td>
                                    <td>@item.Cantidad</td>
                                    <td class="text-end">
                                        <a asp-action="Index" asp-route-id="@item.IdPeriodo" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="ti ti-pencil"></i>
                                        </a>
                                        <form asp-action="Eliminar" asp-route-id="@item.IdPeriodo" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar el periodo @item.IdPeriodo?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPaginas > 1)
            {
                <div class="card-footer d-flex align-items-center">
                    <p class="m-0 text-muted">Página @Model.Pagina de @Model.TotalPaginas</p>
                    <ul class="pagination m-0 ms-auto">
                        <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina - 1)"
                               asp-route-IdPeriodoInicial="@Model.Filtro.IdPeriodoInicial" asp-route-IdPeriodoFinal="@Model.Filtro.IdPeriodoFinal" asp-route-NitGobernante="@Model.Filtro.NitGobernante">
                                <i class="ti ti-chevron-left"></i> Anterior
                            </a>
                        </li>
                        <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina + 1)"
                               asp-route-IdPeriodoInicial="@Model.Filtro.IdPeriodoInicial" asp-route-IdPeriodoFinal="@Model.Filtro.IdPeriodoFinal" asp-route-NitGobernante="@Model.Filtro.NitGobernante">
                                Siguiente <i class="ti ti-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('nitGobernante');
            var nombre = document.getElementById('nombreGobernante');
            var datalist = document.getElementById('nitOptions');
            var opciones = {};
            var temporizador = null;

            input.addEventListener('input', function () {
                var texto = input.value.trim();

                var seleccionado = opciones[texto];
                nombre.value = seleccionado ? seleccionado : '';

                clearTimeout(temporizador);
                if (texto.length < 2) return;

                temporizador = setTimeout(function () {
                    fetch('@Url.Action("BuscarNit")?texto=' + encodeURIComponent(texto))
                        .then(function (r) { return r.json(); })
                        .then(function (lista) {
                            opciones = {};
                            datalist.innerHTML = '';
                            lista.forEach(function (nit) {
                                opciones[nit.numero] = nit.nombre;
                                var opt = document.createElement('option');
                                opt.value = nit.numero;
                                opt.label = nit.numero + ' - ' + nit.nombre;
                                datalist.appendChild(opt);
                            });
                        });
                }, 300);
            });
        })();
    </script>
}
