@{
    ViewData["Title"] = "Periodos administrativos";
}

<div class="page-heading">
    <div class="page-pretitle">Datos básicos</div>
    <h3 class="page-title">Periodos administrativos</h3>
</div>

<div class="row row-cards">
    <div class="col-12 col-xl-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Nuevo periodo</h3>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label" for="codigo">Código</label>
                        <input class="form-control" id="codigo" name="codigo" maxlength="10" placeholder="2026-01" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="nombre">Nombre</label>
                        <input class="form-control" id="nombre" name="nombre" maxlength="80" placeholder="Enero 2026" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="fechaInicio">Fecha inicial</label>
                            <input class="form-control" id="fechaInicio" name="fechaInicio" type="date" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="fechaFin">Fecha final</label>
                            <input class="form-control" id="fechaFin" name="fechaFin" type="date" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="activo" checked />
                            <span class="form-check-label">Activo</span>
                        </label>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="reset" class="btn btn-outline-primary">
                            <i class="ti ti-eraser me-1"></i> Limpiar
                        </button>
                        <button type="button" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i> Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-8">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center w-100 g-2">
                    <div class="col">
                        <h3 class="card-title mb-0">Periodos registrados</h3>
                    </div>
                    <div class="col-12 col-md-auto">
                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <i class="ti ti-search"></i>
                            </span>
                            <input class="form-control" placeholder="Buscar periodo" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Fecha inicial</th>
                            <th>Fecha final</th>
                            <th>Estado</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="ti ti-calendar-time d-block mb-2 fs-1"></i>
                                No hay periodos administrativos registrados.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
