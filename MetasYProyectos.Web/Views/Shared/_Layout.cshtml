<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>@ViewData["Title"] - Metas y Proyectos</title>

    <link rel="stylesheet" href="~/lib/tabler/dist/css/tabler.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/tabler/dist/css/tabler-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/toastify-js/toastify.min.css" />
</head>
<body>
    <div class="page">
        <!-- Sidebar -->
        <aside class="navbar navbar-vertical navbar-expand-sm" data-bs-theme="dark">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Alternar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <h1 class="navbar-brand navbar-brand-autodark">
                    <a href="/">
                        <span class="brand-link">
                            <span class="brand-dot"></span>Metas y Proyectos
                        </span>
                    </a>
                </h1>
                <div class="collapse navbar-collapse" id="sidebar-menu">
                    <ul class="navbar-nav pt-lg-3">
                        <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                            <a class="nav-link" href="/" title="Inicio">
                                <span class="nav-link-icon">
                                    <i class="ti ti-home"></i>
                                </span>
                                <span class="nav-link-title">Inicio</span>
                            </a>
                        </li>

                        @{
                            var mostrarSubmenu = ViewContext.RouteData.Values["controller"]?.ToString() is "MetasProyectos" or "DatosBasicos";
                        }
                        <li class="nav-item @(mostrarSubmenu ? "active" : "")">
                            <a class="nav-link" href="#navbar-modulos" data-bs-toggle="collapse" role="button" aria-expanded="@mostrarSubmenu.ToString().ToLower()" title="Módulos">
                                <span class="nav-link-icon">
                                    <i class="ti ti-target-arrow"></i>
                                </span>
                                <span class="nav-link-title">Metas y Proyectos</span>
                                <span class="nav-link-toggle"></span>
                            </a>
                            <div class="collapse @(mostrarSubmenu ? "show" : "")" id="navbar-modulos">
                                <ul class="nav nav-sm flex-column">
                                    <li class="nav-item">
                                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MetasProyectos" ? "active" : "")" href="/MetasProyectos">
                                            <span class="nav-link-title">Metas y Proyectos</span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DatosBasicos" ? "active" : "")" href="/DatosBasicos">
                                            <span class="nav-link-title">Datos básicos</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                    </ul>
                    <div class="mt-auto text-center py-3">
                        <a class="nav-link sidebar-toggle" href="#" onclick="return false;" title="Colapsar menú">
                            <span class="nav-link-icon">
                                <i class="ti ti-chevron-left sidebar-toggle-icon"></i>
                            </span>
                            <span class="nav-link-title sidebar-toggle-title">Colapsar</span>
                        </a>
                    </div>
                </div>
            </div>
        </aside>

        <div class="page-wrapper">
            <div class="page-header d-print-none">
                <div class="container-xl">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="page-pretitle">Metas y Proyectos</div>
                            <h2 class="page-title mb-0">@ViewData["Title"]</h2>
                        </div>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="col-auto">
                                <form asp-controller="Login" asp-action="CerrarSesion" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-dark btn-sm">
                                        <i class="ti ti-logout me-1"></i> Cerrar sesión
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="page-body">
                <div class="container-xl">
                    @if (TempData["Error"] is string layoutError)
                    {
                        <input type="hidden" data-toast="Error" value="@layoutError" />
                    }
                    @if (TempData["Ok"] is string layoutOk)
                    {
                        <input type="hidden" data-toast="Exito" value="@layoutOk" />
                    }
                    @RenderBody()
                </div>
            </div>

            <footer class="footer footer-transparent d-print-none">
                <div class="container-xl">
                    <div class="row text-center align-items-center flex-row-reverse">
                        <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                            <ul class="list-inline list-inline-dots mb-0">
                                <li class="list-inline-item">
                                    &copy; @DateTime.Now.Year Metas y Proyectos
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/tabler/dist/js/tabler.min.js" asp-append-version="true"></script>
    <script src="~/lib/toastify-js/toastify.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
